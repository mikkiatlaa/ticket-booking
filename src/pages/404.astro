---
import Base from "../layouts/Base.astro";

Astro.response.status = 404;
---

<Base title="Page not found" noindex>
  <section class="wrap hero">
    <p class="eyebrow">404</p>
    <h1 class="display">Not found</h1>
    <p class="lede">That page does not exist, or the event is no longer open.</p>
    <p><a class="btn btn--primary" href="/events">See all events</a></p>
  </section>
</Base>

# Copy to .env.local and fill in. Everything is optional for a local demo.

# --- Email (Gmail) --------------------------------------------------------
# Without these, tickets still work and the email can be previewed in the browser.
# Gmail: turn on 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords (NOT your normal Gmail password).
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM="Deep Dive Demo Night <you@gmail.com>"

# --- Database -------------------------------------------------------------
# Leave empty to use the built-in local database (stored in ./.pglite).
# Set to a Postgres URL (e.g. Neon) when deploying online.
DATABASE_URL=

# --- Public address -------------------------------------------------------
# Only needed when deployed, e.g. https://your-app.vercel.app
PUBLIC_URL=
